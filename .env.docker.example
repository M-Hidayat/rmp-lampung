# TEMPLATE konfigurasi deployment RMP Lampung.
# Salin menjadi .env.docker lalu isi nilainya. File .env.docker sudah
# di-ignore Git dan TIDAK boleh ikut ter-commit.
#
#   cp .env.docker.example .env.docker && nano .env.docker
#   sudo docker compose -f docker-compose.deploy.yml --env-file .env.docker up -d --build

# --- Database (dipakai service postgres_deploy) ---
POSTGRES_USER=rmp
POSTGRES_PASSWORD=GANTI_DENGAN_SANDI_KUAT
POSTGRES_DB=rmp_lampung

# --- Aplikasi ---
# AUTH_SECRET minimal 16 karakter; bangkitkan dengan: openssl rand -base64 32
AUTH_SECRET=GANTI_DENGAN_HASIL_openssl_rand_base64_32

# APP_URL dipakai untuk tautan QR absensi, URL webhook Pakasir, dan QR
# verifikasi sertifikat. Harus URL publik final, tanpa garis miring di akhir.
APP_URL=https://rumahmamapintar.my.id

# --- Pakasir (pembayaran QRIS) ---
PAKASIR_MODE=produksi
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_WEBHOOK_SECRET=

# --- Sertifikat ---
SERTIFIKAT_PENANDATANGAN=
SERTIFIKAT_JABATAN_PENANDATANGAN=Pemilik Rumah Mama Pintar

# --- Bootstrap admin (dipakai sekali oleh `npm run admin:provision`) ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
