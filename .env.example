# Basis data PostgreSQL lokal (lihat docker-compose.yml)
DATABASE_URL="postgresql://rmp:rmp_dev_password@127.0.0.1:5433/rmp_lampung_uji?schema=public"

# Basis data khusus pengujian integrasi (opsional; test integrasi dilewati bila kosong)
TEST_DATABASE_URL="postgresql://rmp:rmp_dev_password@localhost:5433/rmp_lampung_uji?schema=public"

# Rahasia sesi Auth.js (buat dengan: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"

# Integrasi Pakasir
# PAKASIR_MODE: sandbox (adapter dummy internal) atau produksi (memanggil app.pakasir.com)
PAKASIR_MODE="sandbox"
PAKASIR_SLUG="rmp"
PAKASIR_API_KEY="your-pakasir-api-key"
PAKASIR_BASE_URL="https://app.pakasir.com"
PAKASIR_WEBHOOK_SECRET="your-pakasir-webhook-secret"

# URL aplikasi
APP_URL="http://localhost:3001"

# Akun awal hasil seed (wajib diganti pada produksi)
SEED_OWNER_EMAIL="pemilik@contoh.rmp-lampung.test"
SEED_OWNER_PASSWORD="PemilikContoh123!"
SEED_ADMIN_EMAIL="admin@contoh.rmp-lampung.test"
SEED_ADMIN_PASSWORD="AdminContoh123!"
SEED_USER_EMAIL="peserta@contoh.rmp-lampung.test"
SEED_USER_PASSWORD="PesertaContoh123!"

# Tanda tangan pada sertifikat
SERTIFIKAT_PENANDATANGAN="Nama Pemilik RMP"
SERTIFIKAT_JABATAN_PENANDATANGAN="Pemilik RMP - Pelatihan Bisnis Kuliner"
